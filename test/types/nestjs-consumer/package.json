    "@nestjs/passport": "^11.0.0",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.0",
    "typescript": "^5.5.0"
  }
}
